# Odoo Server Configuration
ODOO_URL=https://odoo.yourcompany.com
ODOO_DB=your_odoo_database

# Robot / System Account (Used by server to read project details & write attachments)
ODOO_ROBOT_LOGIN=robot_service@yourcompany.com
ODOO_ROBOT_API_KEY=your_robot_api_key_or_password

# Application Settings
SESSION_SECRET=project-qr-production-secret-key-at-least-32-chars-long
APP_BASE_URL=http://localhost:3000

# Toggle Mock vs Live Odoo
USE_MOCK_ODOO=true
